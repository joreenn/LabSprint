{
  "name": "labsprint",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts docs README.md next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts docs README.md next.config.ts package.json tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
